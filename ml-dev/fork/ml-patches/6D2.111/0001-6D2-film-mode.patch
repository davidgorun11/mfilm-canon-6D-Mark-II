+static uint32_t indexed2rgbLUT[RGB_LUT_SIZE];   /* defined below */
+
 void refresh_yuv_from_rgb(void)
 {
+    uint32_t refresh_t0 = get_ms_clock();
     // get our indexed buffer, convert into our real rgb buffer
     uint8_t *b = bmp_vram_indexed;
     uint32_t *rgb_data = NULL;
@@ -239,6 +253,41 @@ void refresh_yuv_from_rgb(void)
             }
             rgb_row = rgb_row + BMP_LAYER_WIDTH;
         }
+#elif defined(CONFIG_6D2)
+        // M-Film: only the 720x480 the LCD shows, LUT read inline (the table is 256 entries,
+        // so any index is in range), and only the rows that changed since the last refresh:
+        // writing the RGBA layer is the slow part (30 ms for the whole frame). Everything is
+        // redone when the palette changed (ml_refresh_full), when Canon swaps the layer, and
+        // once a second in case Canon cleared it under us. Same "skip transparent" rule as below.
+        {
+            static uint32_t row_hash[480];
+            static uint32_t *last_rgb = NULL;
+            static uint32_t last_full_ms = 0;
+            uint32_t now = get_ms_clock();
+            int full = ml_refresh_full || rgb_data != last_rgb || now - last_full_ms > 1000;
+            if (full) last_full_ms = now;
+            ml_refresh_full = 0;
+            if (rgb_data != last_rgb && last_rgb) ml_rgb_other = last_rgb;      /* Canon swapped its layer: remember the one it left */
+            last_rgb = rgb_data;
+            const uint32_t *lut = indexed2rgbLUT;
+            for (int y = 0; y < 480; y++)
+            {
+                const uint8_t *src = b + BMP_HDMI_OFFSET + y * BMPPITCH;
+                const uint32_t *w = (const uint32_t *) src;     /* 28920 + y*960 is word aligned */
+                uint32_t h = 2166136261u;
+                for (int i = 0; i < 180; i++)
+                    h = (h ^ w[i]) * 16777619u;
+                if (!full && h == row_hash[y])
+                    continue;
+                row_hash[y] = h;
+                uint32_t *dst = rgb_data + BMP_HDMI_OFFSET + y * BMPPITCH;
+                for (int x = 0; x < 720; x++)
+                {
+                    uint32_t rgb = lut[src[x]];
+                    if (rgb) dst[x] = rgb;
+                }
+            }
+        }
 #else
         //SJE FIXME benchmark this loop, it probably wants optimising
         for (size_t n = 0; n < BMP_VRAM_SIZE; n++)
@@ -259,6 +308,7 @@ void refresh_yuv_from_rgb(void)
 #endif
 
     // trigger Ximr to render to OSD from RGB buffer
+    uint32_t ximr_t0 = get_ms_clock();
 #ifdef CONFIG_DIGIC_VI
     XimrExe((void *)XIMR_CONTEXT);
 #else
@@ -266,7 +316,12 @@ void refresh_yuv_from_rgb(void)
     XimrExe((void *)XIMR_CONTEXT);
     give_semaphore(winsys_sem);
 #endif
+    ml_ximr_ms += get_ms_clock() - ximr_t0;
+#ifndef CONFIG_6D2
     ml_refresh_display_needed = 0;
+#endif
+    ml_refresh_count++;
+    ml_refresh_ms += get_ms_clock() - refresh_t0;
 }
 
