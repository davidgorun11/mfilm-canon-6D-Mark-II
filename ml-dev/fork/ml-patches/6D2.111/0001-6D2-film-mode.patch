@@ -275,6 +330,26 @@ void refresh_yuv_from_rgb(void)
 int ml_shutdown_requested = 0;
 #endif
 
+#ifdef CONFIG_6D2
+/* The refresh above never writes transparent pixels (it leaves a clear screen to Canon), so whatever the
+ * film OS last drew stays in the OSD layer. At power off Canon's sensor-cleaning screen then appears over
+ * it: the film OS blanks its 720x480 here, writing real transparent pixels, once the refresh is done. */
+void ml_blank_osd(void)
+{
+    if (rgb_vram_info == NULL) return;
+    uint32_t *rgb_data = (uint32_t *) rgb_vram_info->bitmap_data;
+    for (int y = 0; y < 480; y++)
+        memset(rgb_data + BMP_HDMI_OFFSET + y * BMPPITCH, 0, 720 * sizeof(uint32_t));
+    /* and the layer Canon swapped away from, if it did: what we drew there comes back with the next swap */
+    if (ml_rgb_other && ml_rgb_other != rgb_data)
+        for (int y = 0; y < 480; y++)
+            memset(ml_rgb_other + BMP_HDMI_OFFSET + y * BMPPITCH, 0, 720 * sizeof(uint32_t));
+    take_semaphore(winsys_sem, 0);
+    XimrExe((void *) XIMR_CONTEXT);
+    give_semaphore(winsys_sem);
+}
+#endif
+
