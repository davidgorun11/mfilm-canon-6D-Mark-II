@@ -287,9 +362,21 @@ void refresh_yuv_from_rgb_task(void *unused)
     {
         if (ml_refresh_display_needed && !ml_shutdown_requested && DISPLAY_IS_ON)
         {
+#ifdef CONFIG_6D2
+            /* cleared before, not after: a frame drawn during the refresh asks for the next one */
+            ml_refresh_display_needed = 0;
+            ml_refresh_busy = 1;
             refresh_yuv_from_rgb();
+            ml_refresh_busy = 0;
+#else
+            refresh_yuv_from_rgb();
+#endif
         }
+#ifdef CONFIG_6D2
+        msleep(5);  // M-Film: the film OS animates, 50 ms (20 fps) is too slow for it
+#else
         msleep(50); // max 20 fps refresh
+#endif
     }
 }
 
